<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="road_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>40 20</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>40 20</size></plane></geometry><material><ambient>0.3 0.5 0.3 1</ambient><diffuse>0.3 0.5 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="road_straight">
      <static>true</static>
      <pose>-8 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 3 0.02</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 3 0.02</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <model name="lane_marking_1"><static>true</static><pose>-14 0 0.02 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1.5 0.1 0.01</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="lane_marking_2"><static>true</static><pose>-11 0 0.02 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1.5 0.1 0.01</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="lane_marking_3"><static>true</static><pose>-8 0 0.02 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1.5 0.1 0.01</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="lane_marking_4"><static>true</static><pose>-5 0 0.02 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1.5 0.1 0.01</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="lane_marking_5"><static>true</static><pose>-2 0 0.02 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1.5 0.1 0.01</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>

    <model name="speed_breaker">
      <static>true</static>
      <pose>0 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 3 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 3 0.1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="slope_up">
      <static>true</static>
      <pose>3 0 0.35 0 -0.25 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 3 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3 3 0.05</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="slope_top">
      <static>true</static>
      <pose>5.3 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 3 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 3 0.05</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="slope_down">
      <static>true</static>
      <pose>7.6 0 0.35 0 0.25 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 3 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3 3 0.05</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="road_obstacle_1">
      <static>true</static>
      <pose>-4 0.7 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.6</size></box></geometry><material><ambient>0.6 0.2 0.2 1</ambient><diffuse>0.6 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="road_obstacle_2">
      <static>true</static>
      <pose>-10 -0.6 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry><material><ambient>0.6 0.2 0.2 1</ambient><diffuse>0.6 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- PEDESTRIAN STAND-IN 1: cylinder that slides back and forth across the road -->
    <model name="pedestrian_1">
      <pose>-6 0 0.5 0 0 0</pose>
      <link name="base">
        <inertial><mass>100</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      </link>
      <link name="person">
        <inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry><material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material></visual>
      </link>
      <joint name="anchor_joint" type="fixed">
        <parent>world</parent>
        <child>base</child>
      </joint>
      <joint name="slide_joint" type="prismatic">
        <parent>base</parent>
        <child>person</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-1.3</lower><upper>1.3</upper><effort>1e6</effort></limit>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>slide_joint</joint_name>
        <initial_velocity>0.4</initial_velocity>
      </plugin>
    </model>

    <!-- PEDESTRIAN STAND-IN 2 -->
    <model name="pedestrian_2">
      <pose>-12 0 0.5 0 0 0</pose>
      <link name="base">
        <inertial><mass>100</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      </link>
      <link name="person">
        <inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry><material><ambient>0.1 0.5 0.9 1</ambient><diffuse>0.1 0.5 0.9 1</diffuse></material></visual>
      </link>
      <joint name="anchor_joint" type="fixed">
        <parent>world</parent>
        <child>base</child>
      </joint>
      <joint name="slide_joint" type="prismatic">
        <parent>base</parent>
        <child>person</child>
        <axis>
          <xyz>0 -1 0</xyz>
          <limit><lower>-1.3</lower><upper>1.3</upper><effort>1e6</effort></limit>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>slide_joint</joint_name>
        <initial_velocity>0.3</initial_velocity>
      </plugin>
    </model>

  </world>
</sdf>
