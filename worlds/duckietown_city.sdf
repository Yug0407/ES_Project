          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
        </visual>
        </link>
    </model>

    <!-- Semaforo South (x=-16, y=15) -->
    <model name="traffic_light_south">
      <static>true</static>
      <pose>-16.0 15.0 0 0 0 1.602</pose>
      <link name="link">
        <visual name="pole">
