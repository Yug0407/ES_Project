    <!-- ==============================================================
         SPEED LIMIT SIGN
    ============================================================== -->

    <model name="speed_limit_sign">
      <static>true</static>
      <pose>2.0 12.0 0.0 0 0 -1.585</pose>
      <link name="link">
        <!-- Post -->
        <visual name="post">
          <pose>0 0 0.6 0 0 0</pose>
