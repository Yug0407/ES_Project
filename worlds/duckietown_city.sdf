    <!-- ==============================================================
         TRAFFIC LIGHTS (Semaforos)
         Two traffic-light poles as simple boxes with coloured indicator
    ============================================================== -->

    <!-- Semaforo North (x=-16, y=3) -->
    <model name="traffic_light_north">
      <static>true</static>
      <pose>-16.0 3.0 0 0 0 1.602</pose>
      <link name="link">
        <!-- Pole -->
        <visual name="pole">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- Housing -->
        <visual name="housing">
          <pose>0 0 3.2 0 0 0</pose>
          <geometry><box><size>0.2 0.2 0.6</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <!-- Red light -->
        <visual name="red_light">
          <pose>0 0.13 3.4 0 0 0</pose>
