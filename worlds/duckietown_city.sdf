  <world name="duckietown_city">

    
    <gui><camera name="user_camera"><pose>-1.8 0.6 0.9 0 0.45 0</pose><track_visual><name>waffle_pi</name><min_dist>0.5</min_dist><max_dist>1.8</max_dist><static>true</static></track_visual></camera></gui><plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
