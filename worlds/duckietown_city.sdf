<?xml version="1.0" ?>
<!--
  duckietown_city.sdf
  =====================================================================
  Duckietown-style city grid world for Gazebo Harmonic (SDFormat 1.9).

  Ported from theconstructcore/riabot (Bitbucket) duckietown_gazebo package.
  Original world: duckietown_gazebo/worlds/main.world (SDF 1.5, classic Gazebo).

  Textures live in:
    ../models/duckietown_models/<model>/materials/textures/<file>.png

  The world is laid out on approximately a 40x25 m grid centred around
  the origin.  The TurtleBot3 spawns at (0, 0, 0.05) by default (same
  convention as the other ES_Project worlds).

  Usage (bare Gazebo, no ROS2):
      gz sim -r worlds/duckietown_city.sdf

  Usage (ROS2 + TurtleBot3):
      ros2 launch launch/duckietown_world.launch.py

  Usage (road_world_robot with world override):
      ros2 launch launch/road_world_robot.launch.py \
        world_file:=$(pwd)/worlds/duckietown_city.sdf
  =====================================================================
-->
<sdf version="1.9">
  <world name="duckietown_city">

    <!-- ============================================================
         Plugins  (same set used across all ES_Project worlds)
    ============================================================ -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-dartsim-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- ============================================================
         Physics  (1 kHz, ODE solver)
    ============================================================ -->
    <physics name="ode_1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ============================================================
         Scene  (Ogre2 with shadows)
    ============================================================ -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- ============================================================
         Sun  (directional light, no shadows to keep it cheap)
    ============================================================ -->
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- ============================================================
         Ground plane  (large flat grey surface below the road grid)
    ============================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==============================================================
         ROAD GRID  (ported from main.world / main_mod_v2.world)

         Segment types and textures:
           road_plane   -> road_p.png  (straight, 6x6 m)
           road_inter   -> road_i.png  (4-way intersection, 6x6 m)
           road_diag    -> road_d.png  (curved / diagonal, 6x6 m)
           road_plane_3 -> road3.png   (3-lane straight, 18x6 m)

         All segments are 0.1 m thick boxes raised so their top face
         sits at z = 0.  The robot drives on z = 0.05 (half-height of
         the TurtleBot3).

         Texture URIs are relative to the worlds/ directory so Gazebo
         can resolve them without GZ_SIM_RESOURCE_PATH.
    ============================================================== -->

    <!-- Helper macro (SDF has no macros; segments are listed explicitly) -->

    <!-- Row 0 (y = 3): horizontal main street -->

    <!-- road_plane_3  [18x6]  central long straight -->
    <model name="road_straight_long_r0">
      <static>true</static>
      <pose>-4.534 3 0.001 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>18 6 0.002</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <pbr>
              <metal>
                <albedo_map>../models/duckietown_models/road_plane_3/materials/textures/road3.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- road_inter at west end of row 0 -->
    <model name="road_inter_r0_west">
      <static>true</static>
      <pose>-16.479 3 0.001 0 0 1.5708</pose>
      <link name="link">
        <visual name="vis">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>6 6 0.002</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>../models/duckietown_models/road_inter/materials/textures/road_i.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- road_plane at far west end -->
