          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Descent Ramp: Spans x = +1.5m to +3.5m, Slopes down from z = 0.25m to 0m -->
    <model name="flyover_descent">
      <static>true</static>
      <pose>2.5 9.0 0.125 0 0.124 0</pose>
      <link name="link">
