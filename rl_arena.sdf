        <!-- Flyover Outer Guard Rails -->
        <visual name="rail_north">
          <pose>0 1.52 0.2 0 0 0</pose>
          <geometry><box><size>3.0 0.05 0.25</size></box></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
